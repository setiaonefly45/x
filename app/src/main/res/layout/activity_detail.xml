
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="16dp" android:background="#F5F7FA" android:layout_width="match_parent" android:layout_height="match_parent">
 <TextView android:id="@+id/name" android:text="User" android:textSize="27sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <LinearLayout android:orientation="vertical" android:background="@drawable/bg_card" android:padding="15dp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:id="@+id/info" android:text="" android:textSize="16sp" android:lineSpacingExtra="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </LinearLayout>
 <LinearLayout android:orientation="horizontal" android:layout_marginTop="15dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <Button android:id="@+id/kick" android:text="KICK" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
  <Button android:id="@+id/off" android:text="OFF" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
  <Button android:id="@+id/on" android:text="ON" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
 </LinearLayout>
</LinearLayout>
