
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:orientation="vertical" android:background="#F4F7FB" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="#0B3558"
  android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content">
   <TextView android:text="MikroTik Monitor" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/routerName" android:text="RouterOS 7.24.1" android:textColor="#BBD7EF" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
  <TextView android:id="@+id/connection" android:text="● OFFLINE" android:textColor="#FFFFFF" android:textSize="12sp"/>
 </LinearLayout>

 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="Overview" android:textSize="23sp" android:textStyle="bold" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    <Switch android:id="@+id/darkSwitch" android:text="Dark" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   </LinearLayout>

   <LinearLayout android:orientation="horizontal" android:weightSum="2" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_margin="4dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="104dp">
     <TextView android:text="ONLINE" android:textColor="#667085" android:textSize="11sp"/>
     <TextView android:id="@+id/online" android:text="0" android:textSize="31sp" android:textStyle="bold" android:textColor="#12B76A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_margin="4dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="104dp">
     <TextView android:text="OFFLINE" android:textColor="#667085" android:textSize="11sp"/>
     <TextView android:id="@+id/offline" android:text="0" android:textSize="31sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
   </LinearLayout>
   <LinearLayout android:orientation="horizontal" android:weightSum="2" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_margin="4dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="104dp">
     <TextView android:text="DISABLED" android:textColor="#667085" android:textSize="11sp"/>
     <TextView android:id="@+id/disabled" android:text="0" android:textSize="31sp" android:textStyle="bold" android:textColor="#F04438" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_margin="4dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="104dp">
     <TextView android:text="TOTAL USER" android:textColor="#667085" android:textSize="11sp"/>
     <TextView android:id="@+id/total" android:text="0" android:textSize="31sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
   </LinearLayout>

   <TextView android:text="Bandwidth" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <LinearLayout android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_width="match_parent" android:layout_height="175dp">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
     <TextView android:id="@+id/rxText" android:text="↓ 0 Mbps" android:textSize="16sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
     <TextView android:id="@+id/txText" android:text="↑ 0 Mbps" android:textSize="16sp" android:gravity="right" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:id="@+id/chartText" android:text="▁▂▃▂▄▅▃▆▅▇" android:textSize="22sp" android:gravity="center" android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="MCN-vlan721 • realtime samples" android:textColor="#667085" android:textSize="11sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   </LinearLayout>

   <TextView android:text="ISP" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <LinearLayout android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/isp1" android:text="● MCN-vlan721  UNKNOWN" android:textSize="15sp"/>
    <TextView android:id="@+id/isp2" android:text="● Backup-vlan313  UNKNOWN" android:textSize="15sp" android:layout_marginTop="7dp"/>
    <LinearLayout android:orientation="horizontal" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
     <Button android:id="@+id/ispOn" android:text="ON" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
     <Button android:id="@+id/ispOff" android:text="OFF" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    </LinearLayout>
   </LinearLayout>

   <TextView android:text="System" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <LinearLayout android:orientation="horizontal" android:weightSum="3" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/cpu" android:text="CPU\n0%" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="76dp"/>
    <TextView android:id="@+id/memory" android:text="RAM\n0" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="76dp"/>
    <TextView android:id="@+id/uptime" android:text="UPTIME\n-" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="76dp"/>
   </LinearLayout>

   <LinearLayout android:orientation="horizontal" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <Button android:id="@+id/usersBtn" android:text="USERS" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    <Button android:id="@+id/profilesBtn" android:text="PROFILE" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    <Button android:id="@+id/newBtn" android:text="+ NEW" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    <Button android:id="@+id/settingsBtn" android:text="⚙" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
</LinearLayout>
